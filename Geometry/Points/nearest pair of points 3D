struct pt {
    int x, y, z, id;
};

struct cmp_x {
    bool operator()(const pt & a, const pt & b) const {
        return a.x < b.x || (a.x == b.x && (a.y < b.y || (a.y == b.y && a.z < b.z)));
    }
};

struct cmp_yz {
    bool operator()(const pt & a, const pt & b) const {
        return a.y < b.y || (a.y == b.y && a.z < b.z);
    }
};

int n;
vector<pt> a; /// el points  , sort(all(a),cmp_x()); befor start
double mindist=inf; /// answer
pair<int, int> best_pair;

void upd_ans(const pt & a, const pt & b) {
    double dist = sqrt((a.x - b.x) * (a.x - b.x) +
                       (a.y - b.y) * (a.y - b.y) +
                       (a.z - b.z) * (a.z - b.z));
    if (dist < mindist) {
        mindist = dist;
        best_pair = {a.id, b.id};
    }
}
vector<pt> t;  /// resize n

// r not included
void rec(int l, int r) {
    if (r - l <= 3) {
        for (int i = l; i < r; ++i) {
            for (int j = i + 1; j < r; ++j) {
                upd_ans(a[i], a[j]);
            }
        }
        sort(a.begin() + l, a.begin() + r, cmp_yz());
        return;
    }

    int m = (l + r) >> 1;
    int midx = a[m].x;
    rec(l, m);
    rec(m, r);

    merge(a.begin() + l, a.begin() + m, a.begin() + m, a.begin() + r, t.begin(), cmp_yz());
    copy(t.begin(), t.begin() + r - l, a.begin() + l);

    int tsz = 0;
    for (int i = l; i < r; ++i) {
        if (abs(a[i].x - midx) < mindist) {
            for (int j = tsz - 1; j >= 0 && a[i].y - t[j].y < mindist; --j) {
                if ((a[i].y - t[j].y) * (a[i].y - t[j].y) +
                    (a[i].z - t[j].z) * (a[i].z - t[j].z) < mindist * mindist) {
                    upd_ans(a[i], t[j]);
                }
            }
            t[tsz++] = a[i];
        }
    }
}
