int n;
vector<vpi> adj(N);  // second is edge number
vector<bool> visited,B;
vector<int> tin, low;
int timer;
void dfs(int v, int p = -1) {
    visited[v] = true;
    tin[v] = low[v] = timer++;
    bool parent_skipped = false;
    for (auto &[to,b] : adj[v]) {
        if (to == p && !parent_skipped) {
            parent_skipped = true;
            continue;
        }
        if (visited[to]) {
            low[v] = min(low[v], tin[to]);
        } else {
            dfs(to, v);
            low[v] = min(low[v], low[to]);
            if (low[to] > tin[v])
                B[b]=1;
        }
    }
}
void find_bridges() {
    timer = 0;
    visited.assign(n+1, false);
    tin.assign(n+1, -1);
    low.assign(n+1, -1);
    for (int i = 1; i <= n; ++i) {
        if (!visited[i])
            dfs(i);
    }
}

vi id;
void setIds(int u,int i){
    id[u]=i;
    for(auto&[v,b]:adj[u]){
        if(~id[v]||B[b]) continue;
        setIds(v,i);
    }
}
vvi elTree(){
    find_bridges();
    id.assign(n+1,-1);
    int cur=0;
    for(int i=1;i<=n;++i){
        if(id[i]==-1) setIds(i,cur++);
    }

    vvi ret(n);
    for (int i = 1; i <= n ; ++i) {
        for(auto&[j,b]:adj[i]){
            if(B[b])
                ret[id[i]].pb(id[j]);
        }
    }
    return ret;
}
